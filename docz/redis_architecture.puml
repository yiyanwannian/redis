@startuml Redis架构图

' Redis项目架构图
' 作者：AI助手
' 日期：2023年

!define RECTANGLE class

title Redis架构图

' 使用中文注释
' 允许混合使用不同类型的UML元素
allowmixing

' ===== 核心服务器 =====
package "核心服务器" as CoreServer {
  RECTANGLE "服务器核心" as ServerCore {
    + server : redisServer
    + initServer()
    + serverCron()
    + populateCommandTable()
    + processCommand()
    --
    <b>核心服务器实现</b>
    src/server.c, src/server.h
  }
  
  RECTANGLE "配置管理" as ConfigManager {
    + loadServerConfig()
    + configSetCommand()
    + configGetCommand()
    --
    <b>配置管理</b>
    src/config.c
  }
  
  RECTANGLE "命令表" as CommandTable {
    + commands : dict*
    + lookupCommand()
    + lookupCommandBySds()
    --
    <b>命令表管理</b>
    src/server.c
  }
  
  note bottom of ServerCore
    Redis服务器的核心实现，包含：
    - 服务器状态管理
    - 命令处理
    - 客户端连接管理
    - 数据库管理
    - 定期任务执行
  end note
}

' ===== 事件处理 =====
package "事件处理" as EventHandling {
  RECTANGLE "事件循环" as EventLoop {
    + aeEventLoop
    + aeCreateEventLoop()
    + aeProcessEvents()
    + aeMain()
    --
    <b>事件循环实现</b>
    src/ae.c
  }
  
  RECTANGLE "文件事件" as FileEvents {
    + aeFileEvent
    + aeCreateFileEvent()
    + aeDeleteFileEvent()
    --
    <b>文件事件处理</b>
    src/ae.c
  }
  
  RECTANGLE "时间事件" as TimeEvents {
    + aeTimeEvent
    + aeCreateTimeEvent()
    + aeDeleteTimeEvent()
    --
    <b>时间事件处理</b>
    src/ae.c
  }
  
  RECTANGLE "多路复用API" as Multiplexing {
    + aeApiCreate()
    + aeApiPoll()
    + aeApiName()
    --
    <b>多路复用实现</b>
    src/ae_epoll.c
    src/ae_kqueue.c
    src/ae_select.c
    src/ae_evport.c
  }
  
  note bottom of EventLoop
    Redis的事件处理系统：
    - 基于反应器模式
    - 支持多种I/O多路复用API
    - 处理文件事件和时间事件
    - 高效的事件调度
  end note
}

' ===== 网络处理 =====
package "网络处理" as Networking {
  RECTANGLE "网络库" as Anet {
    + anetTcpServer()
    + anetTcpConnect()
    + anetRead()
    + anetWrite()
    --
    <b>网络库实现</b>
    src/anet.c
  }
  
  RECTANGLE "连接管理" as Connection {
    + connection
    + connCreate()
    + connConnect()
    + connRead()
    + connWrite()
    --
    <b>连接管理</b>
    src/connection.c
  }
  
  RECTANGLE "客户端管理" as ClientManager {
    + client
    + createClient()
    + freeClient()
    + readQueryFromClient()
    + sendReplyToClient()
    --
    <b>客户端管理</b>
    src/networking.c
  }
  
  RECTANGLE "协议解析" as Protocol {
    + processInputBuffer()
    + processMultibulkBuffer()
    + processInlineBuffer()
    --
    <b>协议解析</b>
    src/networking.c
  }
  
  note bottom of ClientManager
    Redis客户端管理：
    - 客户端连接处理
    - 命令解析和执行
    - 回复生成和发送
    - 客户端状态管理
  end note
}

' ===== 数据结构 =====
package "基础数据结构" as DataStructures {
  RECTANGLE "动态字符串" as SDS {
    + sds
    + sdsNew()
    + sdscat()
    + sdscpy()
    --
    <b>动态字符串</b>
    src/sds.c
  }
  
  RECTANGLE "双端链表" as List {
    + list
    + listCreate()
    + listAddNodeHead()
    + listAddNodeTail()
    --
    <b>双端链表</b>
    src/adlist.c
  }
  
  RECTANGLE "字典" as Dict {
    + dict
    + dictCreate()
    + dictAdd()
    + dictFind()
    + dictDelete()
    --
    <b>哈希表</b>
    src/dict.c
  }
  
  RECTANGLE "跳跃表" as SkipList {
    + zskiplist
    + zslCreate()
    + zslInsert()
    + zslDelete()
    --
    <b>跳跃表</b>
    src/t_zset.c
  }
  
  RECTANGLE "整数集合" as IntSet {
    + intset
    + intsetNew()
    + intsetAdd()
    + intsetRemove()
    --
    <b>整数集合</b>
    src/intset.c
  }
  
  RECTANGLE "压缩列表" as ZipList {
    + ziplistNew()
    + ziplistPush()
    + ziplistFind()
    + ziplistDelete()
    --
    <b>压缩列表</b>
    src/ziplist.c
  }
  
  note bottom of Dict
    Redis核心数据结构：
    - 高效的内存使用
    - 针对不同场景优化
    - 支持动态扩展
    - 提供丰富的操作API
  end note
}

' ===== 数据类型 =====
package "Redis数据类型" as DataTypes {
  RECTANGLE "对象系统" as RedisObject {
    + robj
    + createObject()
    + freeObject()
    + incrRefCount()
    + decrRefCount()
    --
    <b>Redis对象系统</b>
    src/object.c
  }
  
  RECTANGLE "字符串" as StringType {
    + setCommand()
    + getCommand()
    + incrCommand()
    --
    <b>字符串类型</b>
    src/t_string.c
  }
  
  RECTANGLE "列表" as ListType {
    + lpushCommand()
    + rpopCommand()
    + lrangeCommand()
    --
    <b>列表类型</b>
    src/t_list.c
  }
  
  RECTANGLE "哈希" as HashType {
    + hsetCommand()
    + hgetCommand()
    + hdelCommand()
    --
    <b>哈希类型</b>
    src/t_hash.c
  }
  
  RECTANGLE "集合" as SetType {
    + saddCommand()
    + sremCommand()
    + sinterCommand()
    --
    <b>集合类型</b>
    src/t_set.c
  }
  
  RECTANGLE "有序集合" as ZSetType {
    + zaddCommand()
    + zrangeCommand()
    + zremCommand()
    --
    <b>有序集合类型</b>
    src/t_zset.c
  }
  
  RECTANGLE "流" as StreamType {
    + xaddCommand()
    + xreadCommand()
    + xrangeCommand()
    --
    <b>流类型</b>
    src/t_stream.c
  }
  
  note bottom of RedisObject
    Redis数据类型：
    - 统一的对象系统
    - 多种编码方式
    - 类型检查和转换
    - 引用计数内存管理
  end note
}

' ===== 持久化 =====
package "持久化" as Persistence {
  RECTANGLE "RDB持久化" as RDB {
    + rdbSave()
    + rdbLoad()
    + rdbSaveBackground()
    --
    <b>RDB持久化</b>
    src/rdb.c
  }
  
  RECTANGLE "AOF持久化" as AOF {
    + feedAppendOnlyFile()
    + loadAppendOnlyFile()
    + rewriteAppendOnlyFile()
    --
    <b>AOF持久化</b>
    src/aof.c
  }
  
  RECTANGLE "混合持久化" as MixedAOF {
    + aofReadDiffFromParent()
    + rewriteAppendOnlyFileBackground()
    --
    <b>混合持久化</b>
    src/aof.c
  }
  
  note bottom of RDB
    Redis持久化系统：
    - RDB：数据快照，适合备份
    - AOF：命令日志，实时性好
    - 混合持久化：结合两者优点
    - 支持后台保存和加载
  end note
}

' ===== 集群 =====
package "集群" as Cluster {
  RECTANGLE "集群管理" as ClusterManager {
    + clusterInit()
    + clusterCron()
    + clusterCommand()
    --
    <b>集群管理</b>
    src/cluster.c
  }
  
  RECTANGLE "节点" as ClusterNode {
