    + createClusterNode()
    + freeClusterNode()
    --
    <b>集群节点</b>
    src/cluster.c
  }
  
  RECTANGLE "槽位管理" as SlotManager {
    + clusterAddSlot()
    + clusterDelSlot()
    + clusterSetSlot()
    --
    <b>槽位管理</b>
    src/cluster.c
  }
  
  RECTANGLE "消息处理" as ClusterMsg {
    + clusterProcessPacket()
    + clusterSendMessage()
    + clusterBroadcastMessage()
    --
    <b>集群消息</b>
    src/cluster.c
  }
  
  note bottom of ClusterManager
    Redis集群系统：
    - 分布式数据分片
    - 节点自动发现
    - 故障检测和转移
    - 集群状态管理
  end note
}

' ===== 复制 =====
package "复制" as Replication {
  RECTANGLE "主从复制" as MasterSlave {
    + replicationFeedSlaves()
    + syncCommand()
    + replconfCommand()
    --
    <b>主从复制</b>
    src/replication.c
  }
  
  RECTANGLE "复制缓冲区" as ReplicationBuffer {
    + replicationBacklog
    + createReplicationBacklog()
    + feedReplicationBacklog()
    --
    <b>复制缓冲区</b>
    src/replication.c
  }
  
  note bottom of MasterSlave
    Redis复制系统：
    - 主从数据同步
    - 部分重同步
    - 复制积压缓冲区
    - 复制状态检测
  end note
}

' ===== 哨兵 =====
package "哨兵" as Sentinel {
  RECTANGLE "哨兵核心" as SentinelCore {
    + sentinelHandleConfiguration()
    + sentinelTimer()
    + sentinelCommand()
    --
    <b>哨兵核心</b>
    src/sentinel.c
  }
  
  RECTANGLE "实例监控" as SentinelMonitor {
    + sentinelRedisInstance
    + sentinelCreateInstanceLink()
    + sentinelCheckSubjectivelyDown()
    --
    <b>实例监控</b>
