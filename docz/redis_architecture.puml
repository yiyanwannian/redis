' ===== 关系定义 =====
' 核心服务器关系
ServerCore --> CommandTable : 管理
ServerCore --> ConfigManager : 使用
ServerCore --> EventLoop : 创建和使用

' 事件处理关系
EventLoop *-- FileEvents : 包含
EventLoop *-- TimeEvents : 包含
EventLoop --> Multiplexing : 使用

' 网络处理关系
ServerCore --> ClientManager : 管理
ClientManager --> Connection : 使用
Connection --> Anet : 使用
ClientManager --> Protocol : 使用

' 数据结构关系
Dict --> SDS : 使用作为键
RedisObject --> SDS : 使用作为字符串编码
RedisObject --> Dict : 使用作为哈希编码
RedisObject --> SkipList : 使用作为有序集合编码
RedisObject --> ZipList : 使用作为紧凑编码
RedisObject --> IntSet : 使用作为集合编码
RedisObject --> List : 使用作为列表编码

' 数据类型关系
StringType --> RedisObject : 使用
ListType --> RedisObject : 使用
HashType --> RedisObject : 使用
SetType --> RedisObject : 使用
ZSetType --> RedisObject : 使用
StreamType --> RedisObject : 使用

' 持久化关系
ServerCore --> RDB : 使用
ServerCore --> AOF : 使用
MixedAOF --> RDB : 使用
MixedAOF --> AOF : 使用

' 集群关系
ServerCore --> ClusterManager : 使用
ClusterManager *-- ClusterNode : 管理
ClusterManager --> SlotManager : 使用
ClusterManager --> ClusterMsg : 使用

' 复制关系
ServerCore --> MasterSlave : 使用
MasterSlave --> ReplicationBuffer : 使用

' 哨兵关系
SentinelCore *-- SentinelMonitor : 管理
SentinelCore --> Failover : 使用

' 模块系统关系
ServerCore --> ModuleAPI : 使用
ModuleAPI --> ModuleCommand : 注册
ModuleAPI --> ModuleDataType : 创建

' 其他组件关系
ServerCore --> Transaction : 处理
ServerCore --> PubSub : 处理
ServerCore --> Lua : 处理
ServerCore --> SlowLog : 记录
ServerCore --> Memory : 使用

@enduml
